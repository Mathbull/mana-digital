@model ManaDigital.Web.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<!-- MAIN DASHBOARD CONTENT -->
<main class="max-w-7xl mx-auto px-6 py-8 flex flex-col gap-8">
    
    <!-- 1. PERFIL E PROGRESSÃO DE PATENTE (LARGURA TOTAL) -->
    <section class="rounded-2xl bg-surface-container-low/60 border border-outline-variant/20 p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-outline-variant/20">
            <!-- User Info -->
            <div class="flex items-center gap-4">
                <div class="relative w-14 h-14 rounded-xl overflow-hidden ring-1 ring-outline-variant/40 flex-shrink-0">
                    <img alt="Aisha" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAXVFm4m234dVHPcGAyY03tziBCQXs5XB67V5HpzFFt67yyh1bZ5SCPul1KE0xPZfqfz4qkG1ZE4G3IzLlAzEr6W2t1Zdv6Ap-I9f7XXXEA_NFqZsDIhRnTI7nSBNi_vLXs0vJI221tFkwkEIwI7xjgvVY2sFZKM9T8zXS7H07Qo6OjOLtwSGPkEaHsbB3UA0e2m17vb8ij5teOmB6e6JiVdd7KD3xpwnho0KPvkR5AKnX8vyXArNHD"/>
                </div>
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="font-title-md text-xl font-semibold text-on-surface tracking-tight">@Model.Apelido</h1>
                        <span class="px-2 py-0.5 rounded-full text-[11px] font-code-sm bg-secondary/10 text-secondary border border-secondary/20">@Model.Patente</span>
                    </div>  
                    <p class="text-xs text-on-surface-variant mt-1">Especialista em Logística Integrada • Hub Manaus (AM-01)</p>
                </div>
            </div>
            <!-- Metric Badges Clean -->
            <div class="flex items-center gap-6">
                <div class="text-right">
                    <span class="block font-code-sm text-[11px] text-on-surface-variant uppercase tracking-wider">Pontuação Total</span>
                    <span class="font-headline-md text-2xl font-bold text-on-surface tracking-tight">@Model.Pontos <span class="text-xs font-code-sm text-secondary font-normal">XP</span></span>
                </div>
                <div class="h-8 w-px bg-outline-variant/30"></div>
                <div class="text-right">
                    <span class="block font-code-sm text-[11px] text-on-surface-variant uppercase tracking-wider">Meta @Model.ProximaPatente</span>
                    <span class="font-code-sm text-sm text-secondary font-medium">Faltam @Model.ProximoNivelPontos XP</span>
                </div>
            </div>
        </div>

        <!-- Linear Patent Progression Bar -->
        <div class="pt-6">
            <div class="flex items-center justify-between text-xs font-code-sm text-on-surface-variant mb-2">
                <span>PROGRESSO DA CARREIRA</span>
                <span class="text-secondary font-semibold">@Model.ProgressoPercentual% concluído</span>
            </div>
        </div>
        
        <div class="relative w-full h-1.5 bg-surface-container rounded-full overflow-hidden my-3">
            <div class="h-full bg-gradient-to-r from-primary via-secondary to-secondary rounded-full" style="width: @Model.ProgressoPercentual%;"></div>
        </div>

        <div class="grid grid-cols-4 text-xs font-code-sm mt-3 pt-1">
            <!-- Bronze -->
            @if (@Model.Pontos >= 0 && @Model.Pontos < 100)
            {
                <div class="flex items-center gap-1.5 text-secondary font-medium">
                    <span class="material-symbols-outlined text-[15px]">workspace_premium</span>
                    <span>Bronze (Atual)</span>
                </div>
            }
            else
            {
                <div class="flex items-center gap-1.5 text-on-surface-variant">
                    <span class="material-symbols-outlined text-[15px] text-secondary">check_circle</span>
                    <span>Bronze</span>
                </div>
            }

            <!-- Prata (>= 100) -->
            @if (@Model.Pontos >= 100)
            {
                if (@Model.Patente == "Prata")
                {
                    <div class="flex items-center gap-1.5 text-secondary font-medium">
                        <span class="material-symbols-outlined text-[15px]">workspace_premium</span>
                        <span>Prata (Atual)</span>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-1.5 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[15px] text-secondary">check_circle</span>
                        <span>Prata</span>
                    </div>
                }
            }
            else
            {
                <div class="flex items-center gap-1.5 text-outline">
                    <span class="material-symbols-outlined text-[15px]">lock</span>
                    <span>Prata</span>
                </div>
            }

            <!-- Ouro (>= 300) -->
            @if (@Model.Pontos >= 300)
            {
                if (@Model.Patente == "Ouro")
                {
                    <div class="flex items-center gap-1.5 text-secondary font-medium">
                        <span class="material-symbols-outlined text-[15px]">workspace_premium</span>
                        <span>Ouro (Atual)</span>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-1.5 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[15px] text-secondary">check_circle</span>
                        <span>Ouro</span>
                    </div>
                }
            }
            else
            {
                <div class="flex items-center gap-1.5 text-outline">
                    <span class="material-symbols-outlined text-[15px]">lock</span>
                    <span>Ouro</span>
                </div>
            }

            <!-- Diamante (>= 600 ou 1000) -->
            @if (@Model.Pontos >= 600)
            {
                <div class="flex items-center gap-1.5 text-on-surface-variant">
                    @if (@Model.Patente == "Diamante")
                    {
                        <span class="material-symbols-outlined text-[15px] text-secondary">workspace_premium</span>
                        <span class="text-secondary font-medium">Diamante (Atual)</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[15px] text-secondary">check_circle</span>
                        <span>Diamante</span>
                    }
                </div>
            }
            else
            {
                <div class="flex items-center gap-1.5 text-outline">
                    <span class="material-symbols-outlined text-[15px]">lock</span>
                    <span>Diamante</span>
                </div>
            }
        </div>
    </section>

    <!-- 2. SESSÃO CENTRAL: DESEMPENHO ATUAL (ESQUERDA) E CLASSIFICAÇÃO (DIREITA) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Coluna Esquerda: Resumo de Performance (6 cols) -->
        <section class="lg:col-span-6 flex flex-col justify-between rounded-2xl bg-surface-container-low/60 border border-outline-variant/20 p-6 md:p-8">
            <div>
                <div class="flex items-center justify-between mb-5">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px] text-secondary">analytics</span>
                        <h2 class="font-title-md text-base font-semibold text-on-surface">Desempenho Atual</h2>
                    </div>
                    <span class="text-xs font-code-sm text-secondary font-semibold">@Model.PercentualGlobal% Global</span>
                </div>

                <div class="space-y-4">
                    <!-- Leituras -->
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-code-sm">
                            <span class="text-on-surface flex items-center gap-1.5 font-sans font-medium text-sm">
                                <span class="material-symbols-outlined text-[16px] text-secondary">menu_book</span> Leituras
                            </span>
                            <span class="text-on-surface-variant">@Model.LeiturasConcluidas/@Model.TotalLeituras <span class="text-secondary ml-1 font-semibold">@Model.PercentualLeituras%</span></span>
                        </div>
                        <div class="w-full h-1.5 bg-surface-container rounded-full overflow-hidden">
                            <div class="bg-secondary h-full rounded-full" style="width: @Model.PercentualLeituras%;"></div>
                        </div>
                    </div>

                    <!-- Vídeos -->
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-code-sm">
                            <span class="text-on-surface flex items-center gap-1.5 font-sans font-medium text-sm">
                                <span class="material-symbols-outlined text-[16px] text-primary">play_circle</span> Vídeos
                            </span>
                            <span class="text-on-surface-variant">@Model.VideosConcluidos/@Model.TotalVideos <span class="text-primary ml-1 font-semibold">@Model.PercentualVideos%</span></span>
                        </div>
                        <div class="w-full h-1.5 bg-surface-container rounded-full overflow-hidden">
                            <div class="bg-primary h-full rounded-full" style="width: @Model.PercentualVideos%;"></div>
                        </div>
                    </div>

                    <!-- Jogos -->
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-code-sm">
                            <span class="text-on-surface flex items-center gap-1.5 font-sans font-medium text-sm">
                                <span class="material-symbols-outlined text-[16px] text-secondary">sports_esports</span> Jogos
                            </span>
                            <span class="text-on-surface-variant">@Model.JogosConcluidos/@Model.TotalJogos <span class="text-secondary ml-1 font-semibold">@Model.PercentualJogos%</span></span>
                        </div>
                        <div class="w-full h-1.5 bg-surface-container rounded-full overflow-hidden">
                            <div class="bg-secondary h-full rounded-full" style="width: @Model.PercentualJogos%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-outline-variant/20 flex items-center justify-between text-xs font-code-sm text-on-surface-variant">
                <span class="flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                    Compliance Lei 7.716 Adimplente
                </span>
                
            </div>
        </section>

        <!-- Coluna Direita: Classificação / Leaderboard (6 cols) -->
        <section class="lg:col-span-6 flex flex-col justify-between rounded-2xl bg-surface-container-low/60 border border-outline-variant/20 p-6">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px] text-secondary">leaderboard</span>
                        <h3 class="font-title-md text-base font-semibold text-on-surface">Classificação</h3>
                    </div>
                    <!-- Tabs -->
                    <div class="flex items-center text-xs font-code-sm bg-surface-container rounded-lg p-0.5">
                        <button class="px-2.5 py-1 rounded-md bg-surface-container-high text-secondary font-medium" id="tab-btn-semanal" onclick="switchRanking('semanal')">Semanal</button>
                        <button class="px-2.5 py-1 rounded-md text-on-surface-variant hover:text-on-surface" id="tab-btn-mensal" onclick="switchRanking('mensal')">Mensal</button>
                        <button class="px-2.5 py-1 rounded-md text-on-surface-variant hover:text-on-surface" id="tab-btn-geral" onclick="switchRanking('geral')">Geral</button>
                    </div>
                </div>

                <!-- Leaderboard Rows List -->
                <div class="space-y-1.5" id="ranking-list">
                    <!-- Preenchido via JavaScript dinamicamente -->
                </div>
            </div>

            <div class="mt-4 pt-3 border-t border-outline-variant/20 flex items-center justify-between text-[11px] font-code-sm text-on-surface-variant">
                <span>Atualização automática a cada atividade</span>
                <span class="text-secondary">Seu rank atualizado</span>
            </div>
        </section>

    </div>

    <!-- 3. SESSÃO INFERIOR: MEDALHAS & CONQUISTAS (PONTA A PONTA COM SCROLL DE 3 LINHAS) -->
    <section class="rounded-2xl bg-surface-container-low/60 border border-outline-variant/20 p-6 md:p-8 flex flex-col gap-4">
        
        <!-- Cabeçalho com Contador -->
        <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-[20px] text-secondary">award_star</span>
                <div>
                    <h3 class="font-title-md text-base font-semibold text-on-surface">Vitrine de Medalhas &amp; Conquistas</h3>
                    <p class="text-xs text-on-surface-variant">Marcos de aprendizagem e engajamento em diversidade étnico-racial</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs font-code-sm text-secondary font-medium px-3 py-1 rounded-lg bg-secondary/10 border border-secondary/20">
                    @(Model.Medalhas?.Count(m => m.Desbloqueada) ?? 0)/@(Model.Medalhas?.Count ?? 0) conquistadas
                </span>
            </div>
        </div>

        <!-- CONTAINER COM SCROLL INTERNO (LIMITADO A 3 LINHAS DE CARDS) -->
        <div class="max-h-[255px] overflow-y-auto pr-2 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3
                    [&::-webkit-scrollbar]:w-1.5 
                    [&::-webkit-scrollbar-track]:bg-surface-container/30 
                    [&::-webkit-scrollbar-track]:rounded-full
                    [&::-webkit-scrollbar-thumb]:bg-outline-variant/40 
                    [&::-webkit-scrollbar-thumb]:rounded-full 
                    hover:[&::-webkit-scrollbar-thumb]:bg-secondary/50">
            
            @if (Model.Medalhas != null && Model.Medalhas.Any())
            {
                @foreach (var medalha in Model.Medalhas.OrderByDescending(m => m.Desbloqueada).ThenBy(m => m.Titulo))
                {
                    if (medalha.Desbloqueada)
                    {
                        <!-- MEDALHA DESBLOQUEADA -->
                        <div class="p-3 rounded-xl bg-surface-container/80 border border-secondary/30 flex items-center gap-3 transition-all hover:border-secondary/60 hover:bg-surface-container">
                            <div class="w-11 h-11 rounded-lg bg-surface-container-high/70 flex items-center justify-center flex-shrink-0 overflow-hidden p-1">
                                <img src="@medalha.Figurinha" alt="@medalha.Titulo" class="w-full h-full object-contain drop-shadow" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-1">
                                    <span class="text-xs font-semibold text-on-surface truncate" title="@medalha.Titulo">@medalha.Titulo</span>
                                    <span class="material-symbols-outlined text-[15px] text-secondary flex-shrink-0">check_circle</span>
                                </div>
                                <p class="text-[10px] text-on-surface-variant truncate pr-1 mt-0.5" title="@medalha.Descricao">@medalha.Descricao</p>
                                <span class="text-[10px] font-code-sm text-secondary font-bold inline-block mt-1">+@medalha.Pontos XP</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- MEDALHA BLOQUEADA -->
                        <div class="p-3 rounded-xl bg-surface-container/20 border border-outline-variant/15 flex items-center gap-3 opacity-55 hover:opacity-85 transition-opacity">
                            <div class="w-11 h-11 rounded-lg bg-surface-container/40 flex items-center justify-center flex-shrink-0 overflow-hidden p-1">
                                <img src="@medalha.Figurinha" alt="@medalha.Titulo" class="w-full h-full object-contain filter grayscale contrast-50 opacity-40" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-1">
                                    <span class="text-xs font-medium text-on-surface-variant truncate" title="@medalha.Titulo">@medalha.Titulo</span>
                                    <span class="material-symbols-outlined text-[15px] text-outline flex-shrink-0">lock</span>
                                </div>
                                <p class="text-[10px] text-outline truncate pr-1 mt-0.5" title="@medalha.Descricao">@medalha.Descricao</p>
                                <span class="text-[10px] font-code-sm text-outline flex-shrink-0 inline-block mt-1">@medalha.Pontos XP</span>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="col-span-full text-center py-8 text-xs text-outline font-code-sm">
                    Nenhuma medalha cadastrada no sistema.
                </div>
            }
        </div>
    </section>

    <!-- SCRIPT DO RANKING -->
    <script>
        window.homeConfig = {
            rankingData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Rankings, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })),
        };
    </script>
    <script src="~/js/pages/home.js" asp-append-version="true"></script>
</main>