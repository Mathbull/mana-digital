@model ManaDigital.Web.ViewModels.JogosViewModel
@{
    ViewData["Title"] = "Simuladores e Jogos";
}

<main class="max-w-7xl mx-auto px-6 py-10 flex flex-col gap-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-outline-variant/30 pb-6">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="font-code-sm text-xs uppercase tracking-wider text-secondary font-medium">Gamificação Tática</span>
                <span class="text-on-surface-variant/40">•</span>
                <span class="text-xs text-on-surface-variant">Concluídos: @Model.JogosConcluidos de @Model.TotalJogos</span>
            </div>
            <h1 class="font-title-md text-2xl lg:text-3xl font-bold tracking-tight text-on-surface">Simuladores de Decisão Antirracista</h1>
            <p class="text-sm text-on-surface-variant mt-1 max-w-2xl">
                Quizzes imersivos para testar tomadas de decisão e conceitos sociopolíticos no ambiente logístico.
            </p>
        </div>

        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-container-low border border-outline-variant/30 text-xs font-code-sm">
            <span class="material-symbols-outlined text-secondary text-[18px]">sports_esports</span>
            <span>Cada quiz vale até <strong>10 XP</strong> (2 XP por acerto)</span>
        </div>
    </div>

    <!-- Grade dos 4 Quizzes -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var game in Model.Games)
        {
            <article class="flex flex-col justify-between rounded-2xl p-6 border transition-all duration-200 shadow-sm
                @(game.Concluido 
                    ? "bg-surface-container-lowest/80 border-secondary/30 hover:border-secondary/60" 
                    : "bg-surface-container-low/60 border-outline-variant/30 hover:border-primary/50 hover:bg-surface-container-low")">
                <div>
                    <div class="flex items-center justify-between mb-3 text-xs font-code-sm">
                        <span class="uppercase tracking-wider px-2.5 py-0.5 rounded @(game.Concluido ? "bg-secondary/10 text-secondary font-semibold" : "bg-primary-container/40 text-primary-fixed")">
                            5 Questões
                        </span>
                        @if (game.Concluido)
                        {
                            <span class="text-secondary font-semibold flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">verified</span> Concluído
                            </span>
                        }
                        else
                        {
                            <span class="text-primary font-semibold flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">bolt</span> +@game.PontosTotal XP
                            </span>
                        }
                    </div>

                    <h2 class="font-title-md text-lg font-semibold text-on-surface mt-2">
                        @game.Titulo
                    </h2>
                    <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
                        @game.Descricao
                    </p>
                </div>

                <div class="mt-8 pt-4 border-t border-outline-variant/30 flex items-center justify-between">
                    <span class="text-xs font-code-sm text-on-surface-variant flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">timer</span> ~5 min
                    </span>

                    <a asp-controller="Jogos" asp-action="Jogar" asp-route-id="@game.Id"
                       class="text-xs font-semibold px-4 py-2 rounded-xl flex items-center gap-2 transition-colors
                       @(game.Concluido 
                           ? "text-secondary hover:bg-secondary/10 border border-secondary/30" 
                           : "text-on-primary bg-primary-container hover:bg-primary-container/80 shadow-md")">
                        <span>@(game.Concluido ? "Revisar Quiz" : "Iniciar Simulação")</span>
                        <span class="material-symbols-outlined text-[16px]">@(game.Concluido ? "visibility" : "play_arrow")</span>
                    </a>
                </div>
            </article>
        }
    </div>
</main>